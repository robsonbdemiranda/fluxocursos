# Configure estas variaveis no ambiente do servidor. Nunca versione um arquivo .env com valores reais.
# Amazon SES, regiao us-east-2. A porta 587 usa STARTTLS, representado por "tls".
CONTACT_RECIPIENT=contato@fluxo.com.br
CONTACT_FROM=contato@fluxo.com.br
SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=credencial-smtp-gerada-no-amazon-ses
SMTP_PASSWORD=senha-smtp-gerada-no-amazon-ses

# Mautic - autenticacao via OAuth2 Client Credentials Grant
MAUTIC_BASE_URL=https://mautic.fluxo.com.br
MAUTIC_PUBLIC_CLIENT_ID=client-id-gerado-no-mautic
MAUTIC_PUBLIC_CLIENT_SECRET=client-secret-gerado-no-mautic

# Webhooks WooCommerce/BuddyBoss - segredo HMAC compartilhado com os plugins
FLUXO_WEBHOOK_SECRET=segredo-longo-e-aleatorio

# Sincronizacao inicial do BuddyBoss - use um token exclusivo, diferente do segredo dos webhooks
BUDDYBOSS_SYNC_TOKEN=token-longo-e-aleatorio
BUDDYBOSS_BASE_URL=https://app.clubedodoppler.com.br
BUDDYBOSS_USERNAME=usuario-wordpress
BUDDYBOSS_APP_PASSWORD=senha-de-aplicativo-wordpress
BUDDYBOSS_COMMUNITY_SLUG=clube-do-doppler
# Opcional; por padrao usa https://fluxocursos.com.br/api/webhook-buddyboss.php
BUDDYBOSS_WEBHOOK_URL=https://fluxocursos.com.br/api/webhook-buddyboss.php
