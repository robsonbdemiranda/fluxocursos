# Configure estas variaveis no ambiente do servidor. Nunca versione um arquivo .env com valores reais.
# Amazon SES, regiao us-east-2. A porta 587 usa STARTTLS, representado por "tls".
CONTACT_RECIPIENT=contato@fluxo.com.br
CONTACT_FROM=contato@fluxo.com.br
SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=credencial-smtp-gerada-no-amazon-ses
SMTP_PASSWORD=senha-smtp-gerada-no-amazon-ses

# Mautic - autenticacao via OAuth2 Client Credentials Grant
MAUTIC_BASE_URL=https://mautic.fluxo.com.br
MAUTIC_PUBLIC_CLIENT_ID=client-id-gerado-no-mautic
MAUTIC_PUBLIC_CLIENT_SECRET=client-secret-gerado-no-mautic
